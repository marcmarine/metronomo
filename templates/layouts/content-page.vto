{{ layout "./base.vto" {
  lang,
  title,
  description,
} }}

{{ slot extraHead }}
  {{ if canonical }}
  <link rel="canonical" href="{{ canonical }}" />
  {{ /if }}
{{ /slot }}

{{ slot extraStyles }}
  <style>
    {{ include "./content-page.css" }}
  </style>
{{ /slot }}

<main class="content-page">
  {{ markdownHtml }}
</main>
