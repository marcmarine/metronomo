<div class="stage">
  <div
    class="stage__gesture-layer"
    aria-label="Toca para iniciar o detener; arrastra verticalmente para cambiar el tempo; arrastra horizontalmente desde el peso o el péndulo para lanzarlo"
  ></div>
  <div class="tempo-wrapper">
    <h4 class="tempo-wrapper__bpm">60 ppm</h4>
    <h5 class="tempo-wrapper__name">Allegro</h5>
  </div>
  {{ include "./_metronome-svg.vto" }}
</div>
