    {{ include "./index.css" }}
    {{ include "../partials/home/_welcome.css" }}
    {{ include "../partials/home/_stage.css" }}
    {{ include "../partials/home/_metronome-svg.css" }}
  </style>
{{ /slot }}

{{ include "../partials/home/_welcome.vto" }}
{{ include "../partials/home/_stage.vto" }}

{{ slot extraScripts }}
  <script type="module" src="/src/main.ts"></script>
{{ /slot }}
